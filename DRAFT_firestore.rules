rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check document for startup getDocFromServer check
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives (Schema & Workspace Integrity without Login Gate)
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRole(role) {
      return role in [
        'super_admin',
        'owner',
        'branch_manager',
        'cashier',
        'warehouse_staff',
        'purchasing_staff',
        'accountant'
      ];
    }

    function isMainWorkspace(orgId) {
      return orgId == 'org_main';
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidOrganization(data) {
      return data.keys().hasAll([
          'organizationId', 'name', 'ownerUid', 'currency', 'timezone', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'name', 'ownerUid', 'currency', 'timezone', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidId(data.ownerUid) &&
        data.currency == 'LAK' &&
        data.timezone == 'Asia/Vientiane' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBranch(data) {
      return data.keys().hasAll([
          'branchId', 'organizationId', 'ownerUid', 'branchCode', 'branchName',
          'address', 'phone', 'managerId', 'assignedUids', 'isMainBranch', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'branchId', 'organizationId', 'ownerUid', 'branchCode', 'branchName',
          'address', 'phone', 'managerId', 'assignedUids', 'isMainBranch', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.branchId) && data.branchId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.branchCode is string && data.branchCode.size() >= 1 && data.branchCode.size() <= 20 && data.branchCode.matches('^[A-Z0-9\\-]+$') &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.managerId is string && data.managerId.size() <= 128 &&
        data.assignedUids is list && data.assignedUids.size() <= 50 &&
        (data.assignedUids.size() == 0 || data.assignedUids[0] is string) &&
        data.isMainBranch is bool &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'organizationId', 'ownerUid', 'name', 'email', 'phone',
          'role', 'branchIds', 'permissions', 'status', 'createdAt', 'lastLoginAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'organizationId', 'ownerUid', 'name', 'email', 'phone',
          'role', 'branchIds', 'permissions', 'invitationId', 'status', 'createdAt', 'lastLoginAt'
        ]) &&
        isValidId(data.uid) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 30 &&
        isValidRole(data.role) &&
        data.branchIds is list && data.branchIds.size() <= 50 &&
        (data.branchIds.size() == 0 || data.branchIds[0] is string) &&
        data.permissions is map &&
        (!('invitationId' in data) || (data.invitationId is string && data.invitationId.size() <= 64)) &&
        data.status in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'auditId', 'organizationId', 'ownerUid', 'userId',
          'userNameSnapshot', 'userRoleSnapshot', 'action', 'entityType',
          'entityId', 'deviceInfo', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'auditId', 'organizationId', 'ownerUid', 'branchId', 'userId',
          'userNameSnapshot', 'userRoleSnapshot', 'action', 'entityType',
          'entityId', 'before', 'after', 'deviceInfo', 'createdAt'
        ]) &&
        isValidId(data.auditId) && data.auditId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 64)) &&
        isValidId(data.userId) &&
        data.userNameSnapshot is string && data.userNameSnapshot.size() <= 120 &&
        data.userRoleSnapshot is string && data.userRoleSnapshot.size() <= 40 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 60 &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        (!('before' in data) || data.before == null || data.before is map) &&
        (!('after' in data) || data.after == null || data.after is map) &&
        data.deviceInfo is string && data.deviceInfo.size() <= 200 &&
        data.createdAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll([
          'organizationId', 'ownerUid', 'receiptSettings', 'taxSettings',
          'currencySettings', 'notificationSettings', 'inventorySettings', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'ownerUid', 'storeProfile', 'receiptSettings', 'taxSettings',
          'currencySettings', 'notificationSettings', 'inventorySettings', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        (!('storeProfile' in data) || data.storeProfile is map) &&
        data.receiptSettings is map &&
        data.taxSettings is map &&
        data.currencySettings is map &&
        data.notificationSettings is map &&
        data.inventorySettings is map &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules (Zero-Auth Direct Workspace with Strict Schema Validation)
    // -------------------------------------------------------------------------

    match /organizations/{organizationId} {
      allow get: if isValidId(organizationId) && isMainWorkspace(organizationId);
      allow list: if isMainWorkspace(existing().organizationId);
      allow create: if isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidOrganization(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidOrganization(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId) &&
        branchId == 'br_hq_01' &&
        isMainWorkspace(existing().organizationId);
      allow list: if false;
      allow create: if isValidId(branchId) &&
        branchId == 'br_hq_01' &&
        isValidBranch(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().branchId == 'br_hq_01' &&
        incoming().isMainBranch == true &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      allow update: if isValidId(branchId) &&
        branchId == 'br_hq_01' &&
        isValidBranch(incoming()) &&
        isMainWorkspace(existing().organizationId) &&
        incoming().branchId == existing().branchId &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().isMainBranch == true &&
        incoming().status == 'active' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'branchName', 'address', 'phone', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && isMainWorkspace(existing().organizationId);
      allow list: if isMainWorkspace(existing().organizationId);
      allow create: if isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        incoming().lastLoginAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      allow update: if isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        isMainWorkspace(existing().organizationId) &&
        incoming().uid == existing().uid &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLoginAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'role', 'branchIds', 'permissions', 'status', 'lastLoginAt'
        ]);
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow get: if isValidId(auditId) && isMainWorkspace(existing().organizationId);
      allow list: if isMainWorkspace(existing().organizationId);
      allow create: if isValidId(auditId) &&
        isValidAuditLog(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().auditId == auditId &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      allow update, delete: if false;
    }

    match /settings/{organizationId} {
      allow get: if isValidId(organizationId) && isMainWorkspace(organizationId);
      allow list: if false;
      allow create: if isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidSetting(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(organizationId));
      allow update: if isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidSetting(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'storeProfile', 'receiptSettings', 'taxSettings',
          'currencySettings', 'notificationSettings', 'inventorySettings', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
