rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check document for startup getDocFromServer check
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives (Firebase Auth + UID-Bound RBAC + Schema)
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidRole(role) {
      return role in [
        'super_admin',
        'owner',
        'branch_manager',
        'cashier',
        'warehouse_staff',
        'purchasing_staff',
        'accountant'
      ];
    }

    function isMainWorkspace(orgId) {
      return orgId == 'org_main';
    }

    function isMainBranchId(branchId) {
      return branchId == 'br_hq_01';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function callerHasProfile() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function callerProfile() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isActiveOrgUser() {
      return callerHasProfile() &&
        callerProfile().status == 'active' &&
        isMainWorkspace(callerProfile().organizationId);
    }

    function isActiveAdmin() {
      return isActiveOrgUser() && callerProfile().role in ['super_admin', 'owner'];
    }

    function canManageStaff() {
      return isActiveAdmin() || (
        isActiveOrgUser() &&
        callerProfile().role == 'branch_manager' &&
        'staff' in callerProfile().permissions &&
        callerProfile().permissions.staff is list &&
        ('create' in callerProfile().permissions.staff || 'edit' in callerProfile().permissions.staff)
      );
    }

    function hasModulePerm(mod, action) {
      return isActiveAdmin() || (
        isActiveOrgUser() &&
        mod in callerProfile().permissions &&
        callerProfile().permissions[mod] is list &&
        action in callerProfile().permissions[mod]
      );
    }

    function isMatchingTokenEmail(email) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        request.auth.token.email is string &&
        request.auth.token.email != '' &&
        email is string &&
        email == request.auth.token.email.lower();
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'alaysisomboun@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidOrganization(data) {
      return data.keys().hasAll([
          'organizationId', 'name', 'ownerUid', 'currency', 'timezone', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'name', 'ownerUid', 'currency', 'timezone', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidId(data.ownerUid) &&
        data.currency == 'LAK' &&
        data.timezone == 'Asia/Vientiane' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBranch(data) {
      return data.keys().hasAll([
          'branchId', 'organizationId', 'ownerUid', 'branchCode', 'branchName',
          'address', 'phone', 'managerId', 'assignedUids', 'isMainBranch', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'branchId', 'organizationId', 'ownerUid', 'branchCode', 'branchName',
          'address', 'phone', 'managerId', 'assignedUids', 'isMainBranch', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.branchId) && data.branchId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.branchCode is string && data.branchCode.size() >= 1 && data.branchCode.size() <= 20 && data.branchCode.matches('^[A-Z0-9\\-]+$') &&
        data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.managerId is string && data.managerId.size() <= 128 &&
        data.assignedUids is list && data.assignedUids.size() <= 50 &&
        (data.assignedUids.size() == 0 || data.assignedUids[0] is string) &&
        data.isMainBranch is bool &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'organizationId', 'ownerUid', 'name', 'email', 'phone',
          'role', 'branchIds', 'permissions', 'status', 'createdAt', 'lastLoginAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'employeeId', 'organizationId', 'ownerUid', 'name', 'email', 'phone',
          'role', 'branchIds', 'permissions', 'invitationId', 'status', 'createdAt', 'lastLoginAt'
        ]) &&
        isValidId(data.uid) &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 30)) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 30 &&
        isValidRole(data.role) &&
        data.branchIds is list && data.branchIds.size() <= 50 &&
        (data.branchIds.size() == 0 || data.branchIds[0] is string) &&
        data.permissions is map &&
        (!('invitationId' in data) || (data.invitationId is string && data.invitationId.size() <= 64)) &&
        data.status in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'auditId', 'organizationId', 'ownerUid', 'userId',
          'userNameSnapshot', 'userRoleSnapshot', 'action', 'entityType',
          'entityId', 'deviceInfo', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'auditId', 'organizationId', 'ownerUid', 'branchId', 'userId',
          'userNameSnapshot', 'userRoleSnapshot', 'action', 'entityType',
          'entityId', 'before', 'after', 'deviceInfo', 'createdAt'
        ]) &&
        isValidId(data.auditId) && data.auditId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 64)) &&
        isValidId(data.userId) &&
        data.userNameSnapshot is string && data.userNameSnapshot.size() <= 120 &&
        data.userRoleSnapshot is string && data.userRoleSnapshot.size() <= 40 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 60 &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        (!('before' in data) || data.before == null || data.before is map) &&
        (!('after' in data) || data.after == null || data.after is map) &&
        data.deviceInfo is string && data.deviceInfo.size() <= 200 &&
        data.createdAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll([
          'organizationId', 'ownerUid', 'receiptSettings', 'taxSettings',
          'currencySettings', 'notificationSettings', 'inventorySettings', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'ownerUid', 'storeProfile', 'receiptSettings', 'taxSettings',
          'currencySettings', 'notificationSettings', 'inventorySettings', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        (!('storeProfile' in data) || data.storeProfile is map) &&
        data.receiptSettings is map &&
        data.taxSettings is map &&
        data.currencySettings is map &&
        data.notificationSettings is map &&
        data.inventorySettings is map &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'categoryId', 'organizationId', 'ownerUid', 'name', 'parentId',
          'description', 'sortOrder', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'categoryId', 'organizationId', 'ownerUid', 'name', 'parentId',
          'description', 'sortOrder', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.categoryId) && data.categoryId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (data.parentId == null || (data.parentId is string && isValidId(data.parentId) && data.parentId.size() <= 64)) &&
        data.description is string && data.description.size() <= 300 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 99999 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStorageLocation(data) {
      return data.keys().hasAll([
          'locationId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'zoneType', 'description', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'locationId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'zoneType', 'description', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.locationId) && data.locationId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 30 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.zoneType in ['shelf', 'warehouse', 'cooler', 'freezer', 'counter'] &&
        data.description is string && data.description.size() <= 200 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'productId', 'organizationId', 'branchId', 'ownerUid', 'sku', 'name',
          'categoryId', 'subCategoryId', 'storageLocationId', 'storageLocationName',
          'baseUnitName', 'barcode', 'barcodes', 'units', 'trackExpiry',
          'costPriceLak', 'retailPriceLak', 'wholesalePriceLak', 'memberPriceLak',
          'minStockBaseQty', 'reorderQtyBaseQty', 'taxable', 'notes', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'productId', 'organizationId', 'branchId', 'ownerUid', 'sku', 'name',
          'categoryId', 'subCategoryId', 'storageLocationId', 'storageLocationName',
          'baseUnitName', 'barcode', 'barcodes', 'units', 'trackExpiry',
          'costPriceLak', 'retailPriceLak', 'wholesalePriceLak', 'memberPriceLak',
          'minStockBaseQty', 'reorderQtyBaseQty', 'taxable', 'imageUrl', 'notes', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.productId) && data.productId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 50 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.categoryId is string && data.categoryId.size() <= 64 &&
        (data.subCategoryId == null || (data.subCategoryId is string && data.subCategoryId.size() <= 64)) &&
        (data.storageLocationId == null || (data.storageLocationId is string && data.storageLocationId.size() <= 64)) &&
        data.storageLocationName is string && data.storageLocationName.size() <= 100 &&
        data.baseUnitName is string && data.baseUnitName.size() >= 1 && data.baseUnitName.size() <= 40 &&
        data.barcode is string && data.barcode.size() <= 64 &&
        data.barcodes is list && data.barcodes.size() <= 15 &&
        (data.barcodes.size() == 0 || data.barcodes[0] is string) &&
        data.units is list && data.units.size() >= 1 && data.units.size() <= 10 &&
        data.units[0] is map &&
        data.trackExpiry is bool &&
        data.costPriceLak is number && data.costPriceLak >= 0 &&
        data.retailPriceLak is number && data.retailPriceLak >= 0 &&
        data.wholesalePriceLak is number && data.wholesalePriceLak >= 0 &&
        data.memberPriceLak is number && data.memberPriceLak >= 0 &&
        data.minStockBaseQty is number && data.minStockBaseQty >= 0 &&
        data.reorderQtyBaseQty is number && data.reorderQtyBaseQty >= 0 &&
        data.taxable is bool &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 45000)) &&
        data.notes is string && data.notes.size() <= 500 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryBalance(data) {
      return data.keys().hasAll([
          'inventoryId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'baseUnitNameSnapshot',
          'qtyOnHandBase', 'reservedQtyBase', 'avgCostLak', 'minStockBaseQty',
          'storageLocationName', 'lastMovementAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inventoryId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'baseUnitNameSnapshot',
          'qtyOnHandBase', 'reservedQtyBase', 'avgCostLak', 'minStockBaseQty',
          'storageLocationName', 'lastMovementAt', 'updatedAt'
        ]) &&
        isValidId(data.inventoryId) && data.inventoryId.size() <= 128 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.productId) && data.productId.size() <= 64 &&
        data.skuSnapshot is string && data.skuSnapshot.size() <= 50 &&
        data.productNameSnapshot is string && data.productNameSnapshot.size() <= 160 &&
        data.baseUnitNameSnapshot is string && data.baseUnitNameSnapshot.size() <= 40 &&
        data.qtyOnHandBase is number &&
        data.reservedQtyBase is number && data.reservedQtyBase >= 0 &&
        data.avgCostLak is number && data.avgCostLak >= 0 &&
        data.minStockBaseQty is number && data.minStockBaseQty >= 0 &&
        data.storageLocationName is string && data.storageLocationName.size() <= 100 &&
        data.lastMovementAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryLot(data) {
      return data.keys().hasAll([
          'lotId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'lotNumber', 'expiryDate',
          'initialQtyBase', 'remainingQtyBase', 'unitCostBaseLak',
          'storageLocationName', 'status', 'receivedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'lotId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'lotNumber', 'expiryDate',
          'initialQtyBase', 'remainingQtyBase', 'unitCostBaseLak',
          'storageLocationName', 'status', 'receivedAt', 'updatedAt'
        ]) &&
        isValidId(data.lotId) && data.lotId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.productId) && data.productId.size() <= 64 &&
        data.skuSnapshot is string && data.skuSnapshot.size() <= 50 &&
        data.productNameSnapshot is string && data.productNameSnapshot.size() <= 160 &&
        data.lotNumber is string && data.lotNumber.size() >= 1 && data.lotNumber.size() <= 60 &&
        (data.expiryDate == null || (data.expiryDate is string && data.expiryDate.size() <= 20)) &&
        data.initialQtyBase is number && data.initialQtyBase >= 0 &&
        data.remainingQtyBase is number && data.remainingQtyBase >= 0 &&
        data.unitCostBaseLak is number && data.unitCostBaseLak >= 0 &&
        data.storageLocationName is string && data.storageLocationName.size() <= 100 &&
        data.status in ['active', 'depleted', 'expired'] &&
        data.receivedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll([
          'movementId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'lotId', 'lotNumberSnapshot',
          'movementType', 'unitName', 'conversionFactor', 'inputQty',
          'baseQtyDelta', 'balanceBeforeBase', 'balanceAfterBase',
          'unitCostBaseLak', 'totalCostLak', 'reason', 'referenceNo',
          'performedByUid', 'performedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'movementId', 'organizationId', 'branchId', 'ownerUid', 'productId',
          'skuSnapshot', 'productNameSnapshot', 'lotId', 'lotNumberSnapshot',
          'movementType', 'unitName', 'conversionFactor', 'inputQty',
          'baseQtyDelta', 'balanceBeforeBase', 'balanceAfterBase',
          'unitCostBaseLak', 'totalCostLak', 'reason', 'referenceNo',
          'performedByUid', 'performedByName', 'createdAt'
        ]) &&
        isValidId(data.movementId) && data.movementId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.productId) && data.productId.size() <= 64 &&
        data.skuSnapshot is string && data.skuSnapshot.size() <= 50 &&
        data.productNameSnapshot is string && data.productNameSnapshot.size() <= 160 &&
        (data.lotId == null || (data.lotId is string && data.lotId.size() <= 64)) &&
        (data.lotNumberSnapshot == null || (data.lotNumberSnapshot is string && data.lotNumberSnapshot.size() <= 60)) &&
        data.movementType in ['initial', 'stock_in', 'stock_out', 'damaged', 'expired', 'lost', 'adjustment_in', 'adjustment_out', 'sale', 'sale_return', 'sale_void'] &&
        data.unitName is string && data.unitName.size() >= 1 && data.unitName.size() <= 40 &&
        data.conversionFactor is number && data.conversionFactor >= 1 &&
        data.inputQty is number && data.inputQty > 0 &&
        data.baseQtyDelta is number &&
        data.balanceBeforeBase is number &&
        data.balanceAfterBase is number &&
        data.unitCostBaseLak is number && data.unitCostBaseLak >= 0 &&
        data.totalCostLak is number && data.totalCostLak >= 0 &&
        data.reason is string && data.reason.size() <= 300 &&
        data.referenceNo is string && data.referenceNo.size() <= 60 &&
        isValidId(data.performedByUid) &&
        data.performedByName is string && data.performedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidSaleOrder(data) {
      return data.keys().hasAll([
          'saleId', 'invoiceNumber', 'organizationId', 'branchId', 'ownerUid',
          'priceTier', 'customerId', 'customerName', 'items', 'subtotalLak',
          'itemDiscountTotalLak', 'billDiscountLak', 'taxableAmountLak',
          'taxRate', 'taxAmountLak', 'grandTotalLak', 'cogsTotalLak',
          'grossProfitLak', 'paymentMethod', 'payments', 'paidAmountLak',
          'changeAmountLak', 'creditDueLak', 'status', 'notes', 'cashierUid',
          'cashierName', 'voidedReason', 'voidedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'saleId', 'invoiceNumber', 'organizationId', 'branchId', 'ownerUid',
          'priceTier', 'customerId', 'customerName', 'items', 'subtotalLak',
          'itemDiscountTotalLak', 'billDiscountLak', 'taxableAmountLak',
          'taxRate', 'taxAmountLak', 'grandTotalLak', 'cogsTotalLak',
          'grossProfitLak', 'paymentMethod', 'payments', 'paidAmountLak',
          'changeAmountLak', 'creditDueLak', 'status', 'notes', 'cashierUid',
          'cashierName', 'voidedReason', 'voidedByName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.saleId) && data.saleId.size() <= 64 &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.priceTier in ['retail', 'wholesale', 'member'] &&
        (data.customerId == null || (data.customerId is string && data.customerId.size() <= 64)) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
        data.items[0] is map &&
        data.subtotalLak is number && data.subtotalLak >= 0 &&
        data.itemDiscountTotalLak is number && data.itemDiscountTotalLak >= 0 &&
        data.billDiscountLak is number && data.billDiscountLak >= 0 &&
        data.taxableAmountLak is number && data.taxableAmountLak >= 0 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        data.taxAmountLak is number && data.taxAmountLak >= 0 &&
        data.grandTotalLak is number && data.grandTotalLak >= 0 &&
        data.cogsTotalLak is number && data.cogsTotalLak >= 0 &&
        data.grossProfitLak is number &&
        data.paymentMethod in ['cash', 'transfer', 'qr', 'credit', 'split'] &&
        data.payments is list && data.payments.size() >= 1 && data.payments.size() <= 5 &&
        data.payments[0] is map &&
        data.paidAmountLak is number && data.paidAmountLak >= 0 &&
        data.changeAmountLak is number && data.changeAmountLak >= 0 &&
        data.creditDueLak is number && data.creditDueLak >= 0 &&
        data.status in ['completed', 'partial_return', 'returned', 'voided'] &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidId(data.cashierUid) &&
        data.cashierName is string && data.cashierName.size() <= 120 &&
        (data.voidedReason == null || (data.voidedReason is string && data.voidedReason.size() <= 300)) &&
        (data.voidedByName == null || (data.voidedByName is string && data.voidedByName.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSaleReturn(data) {
      return data.keys().hasAll([
          'returnId', 'returnNumber', 'saleId', 'invoiceNumber', 'organizationId',
          'branchId', 'ownerUid', 'items', 'totalRefundLak', 'refundMethod',
          'reason', 'performedByUid', 'performedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'returnId', 'returnNumber', 'saleId', 'invoiceNumber', 'organizationId',
          'branchId', 'ownerUid', 'items', 'totalRefundLak', 'refundMethod',
          'reason', 'performedByUid', 'performedByName', 'createdAt'
        ]) &&
        isValidId(data.returnId) && data.returnId.size() <= 64 &&
        data.returnNumber is string && data.returnNumber.size() >= 1 && data.returnNumber.size() <= 40 &&
        isValidId(data.saleId) && data.saleId.size() <= 64 &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
        data.items[0] is map &&
        data.totalRefundLak is number && data.totalRefundLak >= 0 &&
        data.refundMethod in ['cash', 'transfer', 'credit_adjust'] &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        isValidId(data.performedByUid) &&
        data.performedByName is string && data.performedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidPosHeldBill(data) {
      return data.keys().hasAll([
          'heldId', 'organizationId', 'branchId', 'ownerUid', 'label',
          'priceTier', 'customerName', 'billDiscountLak', 'items', 'notes',
          'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'heldId', 'organizationId', 'branchId', 'ownerUid', 'label',
          'priceTier', 'customerName', 'billDiscountLak', 'items', 'notes',
          'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.heldId) && data.heldId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
        data.priceTier in ['retail', 'wholesale', 'member'] &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.billDiscountLak is number && data.billDiscountLak >= 0 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
        data.items[0] is map &&
        data.notes is string && data.notes.size() <= 300 &&
        data.status in ['held', 'resumed', 'discarded'] &&
        isValidId(data.createdByUid) &&
        data.createdByName is string && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMembershipTier(data) {
      return data.keys().hasAll([
          'tierId', 'organizationId', 'ownerUid', 'name', 'discountPercent',
          'pointsPer1000Lak', 'minSpendLak', 'description', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tierId', 'organizationId', 'ownerUid', 'name', 'discountPercent',
          'pointsPer1000Lak', 'minSpendLak', 'description', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.tierId) && data.tierId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
        data.pointsPer1000Lak is number && data.pointsPer1000Lak >= 0 &&
        data.minSpendLak is number && data.minSpendLak >= 0 &&
        data.description is string && data.description.size() <= 300 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPromotion(data) {
      return data.keys().hasAll([
          'promotionId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'promoType', 'discountValue', 'minSpendLak', 'startDate',
          'endDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'promotionId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'promoType', 'discountValue', 'minSpendLak', 'startDate',
          'endDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.promotionId) && data.promotionId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.code is string && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.promoType in ['percent_bill', 'fixed_bill'] &&
        data.discountValue is number && data.discountValue >= 0 &&
        data.minSpendLak is number && data.minSpendLak >= 0 &&
        data.startDate is string && data.startDate.size() <= 20 &&
        data.endDate is string && data.endDate.size() <= 20 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
          'customerId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'phone', 'email', 'address', 'tierId', 'tierName',
          'pointsBalance', 'creditLimitLak', 'creditBalanceLak',
          'totalSpentLak', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'customerId', 'organizationId', 'branchId', 'ownerUid', 'code',
          'name', 'phone', 'email', 'address', 'tierId', 'tierName',
          'pointsBalance', 'creditLimitLak', 'creditBalanceLak',
          'totalSpentLak', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.customerId) && data.customerId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.code is string && data.code.size() <= 30 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 160 &&
        data.address is string && data.address.size() <= 300 &&
        (data.tierId == null || (data.tierId is string && data.tierId.size() <= 64)) &&
        data.tierName is string && data.tierName.size() <= 80 &&
        data.pointsBalance is number && data.pointsBalance >= 0 &&
        data.creditLimitLak is number && data.creditLimitLak >= 0 &&
        data.creditBalanceLak is number && data.creditBalanceLak >= 0 &&
        data.totalSpentLak is number && data.totalSpentLak >= 0 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll([
          'supplierId', 'organizationId', 'ownerUid', 'code', 'name',
          'contactName', 'phone', 'email', 'address', 'paymentTermDays',
          'payableBalanceLak', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'supplierId', 'organizationId', 'ownerUid', 'code', 'name',
          'contactName', 'phone', 'email', 'address', 'paymentTermDays',
          'payableBalanceLak', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.supplierId) && data.supplierId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.code is string && data.code.size() <= 30 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.contactName is string && data.contactName.size() <= 100 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 160 &&
        data.address is string && data.address.size() <= 300 &&
        data.paymentTermDays is number && data.paymentTermDays >= 0 &&
        data.payableBalanceLak is number && data.payableBalanceLak >= 0 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPurchaseOrder(data) {
      return data.keys().hasAll([
          'poId', 'poNumber', 'organizationId', 'branchId', 'ownerUid',
          'supplierId', 'supplierName', 'items', 'subtotalLak', 'discountLak',
          'shippingFeeLak', 'taxAmountLak', 'grandTotalLak', 'paymentType',
          'paidAmountLak', 'creditDueLak', 'dueDate', 'status', 'notes',
          'createdByUid', 'createdByName', 'receivedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'poId', 'poNumber', 'organizationId', 'branchId', 'ownerUid',
          'supplierId', 'supplierName', 'items', 'subtotalLak', 'discountLak',
          'shippingFeeLak', 'taxAmountLak', 'grandTotalLak', 'paymentType',
          'paidAmountLak', 'creditDueLak', 'dueDate', 'status', 'notes',
          'createdByUid', 'createdByName', 'receivedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.poId) && data.poId.size() <= 64 &&
        data.poNumber is string && data.poNumber.size() >= 1 && data.poNumber.size() <= 40 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.supplierId) && data.supplierId.size() <= 64 &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 140 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
        data.items[0] is map &&
        data.subtotalLak is number && data.subtotalLak >= 0 &&
        data.discountLak is number && data.discountLak >= 0 &&
        data.shippingFeeLak is number && data.shippingFeeLak >= 0 &&
        data.taxAmountLak is number && data.taxAmountLak >= 0 &&
        data.grandTotalLak is number && data.grandTotalLak >= 0 &&
        data.paymentType in ['cash', 'credit'] &&
        data.paidAmountLak is number && data.paidAmountLak >= 0 &&
        data.creditDueLak is number && data.creditDueLak >= 0 &&
        (data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 20)) &&
        data.status in ['ordered', 'received', 'cancelled'] &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidId(data.createdByUid) &&
        data.createdByName is string && data.createdByName.size() <= 120 &&
        (data.receivedAt == null || data.receivedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidArPayment(data) {
      return data.keys().hasAll([
          'paymentId', 'organizationId', 'branchId', 'ownerUid', 'customerId',
          'customerName', 'saleId', 'invoiceNumber', 'amountLak', 'paymentMethod',
          'notes', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'paymentId', 'organizationId', 'branchId', 'ownerUid', 'customerId',
          'customerName', 'saleId', 'invoiceNumber', 'amountLak', 'paymentMethod',
          'notes', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        isValidId(data.paymentId) && data.paymentId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.customerId) && data.customerId.size() <= 64 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        (data.saleId == null || (data.saleId is string && data.saleId.size() <= 64)) &&
        data.invoiceNumber is string && data.invoiceNumber.size() <= 40 &&
        data.amountLak is number && data.amountLak > 0 &&
        data.paymentMethod in ['cash', 'transfer', 'qr'] &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidId(data.recordedByUid) &&
        data.recordedByName is string && data.recordedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidApPayment(data) {
      return data.keys().hasAll([
          'paymentId', 'organizationId', 'branchId', 'ownerUid', 'supplierId',
          'supplierName', 'poId', 'poNumber', 'amountLak', 'paymentMethod',
          'notes', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'paymentId', 'organizationId', 'branchId', 'ownerUid', 'supplierId',
          'supplierName', 'poId', 'poNumber', 'amountLak', 'paymentMethod',
          'notes', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        isValidId(data.paymentId) && data.paymentId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        isValidId(data.supplierId) && data.supplierId.size() <= 64 &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 140 &&
        (data.poId == null || (data.poId is string && data.poId.size() <= 64)) &&
        data.poNumber is string && data.poNumber.size() <= 40 &&
        data.amountLak is number && data.amountLak > 0 &&
        data.paymentMethod in ['cash', 'transfer', 'qr'] &&
        data.notes is string && data.notes.size() <= 300 &&
        isValidId(data.recordedByUid) &&
        data.recordedByName is string && data.recordedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidIncomeEntry(data) {
      return data.keys().hasAll([
          'entryId', 'organizationId', 'branchId', 'ownerUid', 'category',
          'title', 'amountLak', 'paymentMethod', 'referenceNo', 'notes',
          'entryDate', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'entryId', 'organizationId', 'branchId', 'ownerUid', 'category',
          'title', 'amountLak', 'paymentMethod', 'referenceNo', 'notes',
          'entryDate', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        isValidId(data.entryId) && data.entryId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.category in ['sales', 'ar_collection', 'other_income'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.amountLak is number && data.amountLak > 0 &&
        data.paymentMethod in ['cash', 'transfer', 'qr'] &&
        data.referenceNo is string && data.referenceNo.size() <= 60 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.entryDate is string && data.entryDate.size() >= 1 && data.entryDate.size() <= 20 &&
        isValidId(data.recordedByUid) &&
        data.recordedByName is string && data.recordedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidExpenseEntry(data) {
      return data.keys().hasAll([
          'entryId', 'organizationId', 'branchId', 'ownerUid', 'category',
          'title', 'amountLak', 'paymentMethod', 'referenceNo', 'notes',
          'entryDate', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'entryId', 'organizationId', 'branchId', 'ownerUid', 'category',
          'title', 'amountLak', 'paymentMethod', 'referenceNo', 'notes',
          'entryDate', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        isValidId(data.entryId) && data.entryId.size() <= 64 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.category in ['inventory_purchase', 'rent', 'utilities', 'salary', 'transport', 'marketing', 'maintenance_other'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.amountLak is number && data.amountLak > 0 &&
        data.paymentMethod in ['cash', 'transfer', 'qr'] &&
        data.referenceNo is string && data.referenceNo.size() <= 60 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.entryDate is string && data.entryDate.size() >= 1 && data.entryDate.size() <= 20 &&
        isValidId(data.recordedByUid) &&
        data.recordedByName is string && data.recordedByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll([
          'journalId', 'entryNumber', 'organizationId', 'branchId', 'ownerUid',
          'entryDate', 'description', 'sourceType', 'referenceNo', 'lines',
          'totalDebitLak', 'totalCreditLak', 'createdByUid', 'createdByName',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'journalId', 'entryNumber', 'organizationId', 'branchId', 'ownerUid',
          'entryDate', 'description', 'sourceType', 'referenceNo', 'lines',
          'totalDebitLak', 'totalCreditLak', 'createdByUid', 'createdByName',
          'createdAt'
        ]) &&
        isValidId(data.journalId) && data.journalId.size() <= 64 &&
        data.entryNumber is string && data.entryNumber.size() >= 1 && data.entryNumber.size() <= 40 &&
        isValidId(data.organizationId) && data.organizationId.size() <= 64 &&
        isMainBranchId(data.branchId) &&
        isValidId(data.ownerUid) &&
        data.entryDate is string && data.entryDate.size() >= 1 && data.entryDate.size() <= 20 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        data.sourceType in ['manual', 'sale', 'purchase', 'expense', 'income', 'ar_payment', 'ap_payment'] &&
        data.referenceNo is string && data.referenceNo.size() <= 60 &&
        data.lines is list && data.lines.size() >= 2 && data.lines.size() <= 30 &&
        data.lines[0] is map &&
        data.totalDebitLak is number && data.totalDebitLak > 0 &&
        data.totalCreditLak is number && data.totalCreditLak > 0 &&
        data.totalDebitLak == data.totalCreditLak &&
        isValidId(data.createdByUid) &&
        data.createdByName is string && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules (Authenticated Workspace with UID-Bound RBAC & Validation)
    // -------------------------------------------------------------------------

    match /organizations/{organizationId} {
      allow get: if isSignedIn() && isValidId(organizationId) && isMainWorkspace(organizationId);
      allow list: if isActiveOrgUser() && isMainWorkspace(existing().organizationId);
      allow create: if isSignedIn() &&
        isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidOrganization(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidOrganization(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isActiveAdmin() &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          ) ||
          (
            existing().ownerUid == 'usr_owner_main' &&
            !callerHasProfile() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt']) &&
            getAfter(userDocPath(request.auth.uid)).data.role == 'super_admin'
          )
        );
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow get: if isSignedIn() &&
        isValidId(branchId) &&
        isMainBranchId(branchId) &&
        isMainWorkspace(existing().organizationId);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(branchId) &&
        isMainBranchId(branchId) &&
        isValidBranch(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().branchId == 'br_hq_01' &&
        incoming().isMainBranch == true &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId)) &&
        (isActiveAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isActiveOrgUser() &&
        hasModulePerm('settings', 'edit') &&
        isValidId(branchId) &&
        isMainBranchId(branchId) &&
        isValidBranch(incoming()) &&
        isMainWorkspace(existing().organizationId) &&
        incoming().branchId == existing().branchId &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().isMainBranch == true &&
        incoming().status == 'active' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'branchName', 'address', 'phone', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if isSignedIn() &&
        isValidId(uid) &&
        (request.auth.uid == uid || (isActiveOrgUser() && isMainWorkspace(existing().organizationId)));
      allow list: if isSignedIn() &&
        isMainWorkspace(existing().organizationId) &&
        (isActiveOrgUser() || isMatchingTokenEmail(existing().email));
      allow create: if isSignedIn() &&
        isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        incoming().lastLoginAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId)) &&
        (
          isActiveAdmin() ||
          (
            canManageStaff() &&
            !(incoming().role in ['super_admin', 'owner'])
          ) ||
          (
            uid == request.auth.uid &&
            !exists(/databases/$(database)/documents/organizations/org_main) &&
            incoming().ownerUid == request.auth.uid &&
            incoming().role == 'super_admin' &&
            incoming().status == 'active'
          ) ||
          (
            uid == request.auth.uid &&
            exists(/databases/$(database)/documents/organizations/org_main) &&
            get(/databases/$(database)/documents/organizations/org_main).data.ownerUid == 'usr_owner_main' &&
            getAfter(/databases/$(database)/documents/organizations/org_main).data.ownerUid == request.auth.uid &&
            incoming().ownerUid == request.auth.uid &&
            incoming().role == 'super_admin' &&
            incoming().status == 'active'
          ) ||
          (
            uid == request.auth.uid &&
            isBootstrappedAdmin() &&
            incoming().role == 'super_admin' &&
            incoming().status == 'active'
          ) ||
          (
            uid == request.auth.uid &&
            'invitationId' in incoming() &&
            isValidId(incoming().invitationId) &&
            exists(userDocPath(incoming().invitationId)) &&
            isMatchingTokenEmail(get(userDocPath(incoming().invitationId)).data.email) &&
            get(userDocPath(incoming().invitationId)).data.status == 'active' &&
            incoming().role == get(userDocPath(incoming().invitationId)).data.role &&
            incoming().permissions == get(userDocPath(incoming().invitationId)).data.permissions &&
            incoming().status == get(userDocPath(incoming().invitationId)).data.status
          )
        );
      allow update: if isSignedIn() &&
        isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        isMainWorkspace(existing().organizationId) &&
        incoming().uid == existing().uid &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLoginAt == request.time &&
        (
          (
            request.auth.uid == uid &&
            isActiveOrgUser() &&
            incoming().role == existing().role &&
            incoming().permissions == existing().permissions &&
            incoming().status == existing().status &&
            incoming().branchIds == existing().branchIds &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt'])
          ) ||
          (
            isActiveAdmin() &&
            (uid != request.auth.uid || incoming().status == 'active') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'employeeId', 'email', 'phone', 'role', 'branchIds', 'permissions', 'status', 'lastLoginAt'
            ])
          ) ||
          (
            canManageStaff() &&
            uid != request.auth.uid &&
            !(existing().role in ['super_admin', 'owner']) &&
            !(incoming().role in ['super_admin', 'owner']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'employeeId', 'email', 'phone', 'role', 'branchIds', 'permissions', 'status', 'lastLoginAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow get: if isActiveOrgUser() &&
        isValidId(auditId) &&
        isMainWorkspace(existing().organizationId) &&
        (hasModulePerm('staff', 'view') || hasModulePerm('dashboard', 'view') || hasModulePerm('backup', 'view') || existing().userId == request.auth.uid);
      allow list: if isActiveOrgUser() &&
        isMainWorkspace(existing().organizationId) &&
        (hasModulePerm('staff', 'view') || hasModulePerm('dashboard', 'view') || hasModulePerm('backup', 'view') || existing().userId == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(auditId) &&
        isValidAuditLog(incoming()) &&
        isMainWorkspace(incoming().organizationId) &&
        incoming().auditId == auditId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId)) &&
        (
          isActiveOrgUser() ||
          existsAfter(userDocPath(request.auth.uid))
        );
      allow update, delete: if false;
    }

    match /settings/{organizationId} {
      allow get: if isActiveOrgUser() && isValidId(organizationId) && isMainWorkspace(organizationId);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(organizationId) &&
        isMainWorkspace(organizationId) &&
        isValidSetting(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(organizationId)) &&
        (isActiveAdmin() || incoming().ownerUid == request.auth.uid);
